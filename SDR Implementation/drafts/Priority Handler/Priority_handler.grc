      ''50''), (''buffer_margin_ms'', ''20'')], [(''ack_in'', ''message'', 1), (''addr_in'',
      ''message'', 1), (''msg_in'', ''message'', 1)], [(''feedback_out'', ''message'',
      1), (''packet_out'', ''message'', 1)], ''\n        Args:\n            buffer_margin_ms:
