      \        if not pmt.is_pair(msg): return\n        # ACKs are critical, always\
      \ 0\n        with self.lock:\n            self.tx_queue.append({'msg': msg,\
      \ 'prio': 0})\n\n    def run_tx_loop(self):\n        while not self.stop_thread:\n\
      \            current_time = time.time()\n            msg_to_send = None\n  \
      \          \n            # === 1. AGING LOGIC (Timer Based) ===\n          \
      \  if (current_time - self.last_aging_time) > self.aging_interval:\n       \
      \         with self.lock:\n                    if len(self.tx_queue) > 0:\n\
      \                        # Decrement priority of EVERY packet currently waiting\n\
      \                        # (Lower number = Higher Priority)\n              \
      \          for item in self.tx_queue:\n                            # ACKs (Prio\
      \ 0) stay at 0 or go negative, which is fine\n                            item['prio']\
      \ -= 1\n                \n                self.last_aging_time = current_time\n\
      \n            # === 2. SENDING LOGIC ===\n            with self.lock:\n    \
      \            if len(self.tx_queue) > 0:\n                    # Sort: Ascending\
      \ order (Lowest number = Highest Priority)\n                    # Python's sort\
      \ is stable (preserves FIFO for ties)\n                    self.tx_queue.sort(key=lambda\
      \ x: x['prio'])\n                    \n                    # Pop the most important\
      \ message\n                    item = self.tx_queue.pop(0)\n               \
      \     msg_to_send = item['msg']\n            \n            # === 3. HARDWARE\
      \ OUTPUT ===\n            if msg_to_send:\n                self.message_port_pub(pmt.intern('pdu_out'),\
      \ msg_to_send)\n                # Small gap to prevent hardware buffer overrun\n\
      \                time.sleep(0.005) \n            else:\n                # Sleep\
      \ if idle to save CPU\n                time.sleep(0.002)\n"
    affinity: ''
    aging_interval_ms: '10000'
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: '(''MAC Arbiter (Timer Aging)'', ''blk'', [(''aging_interval_ms'',
      ''200'')], [(''ack_in'', ''message'', 1), (''data_in'', ''message'', 1)], [(''pdu_out'',
      ''message'', 1)], ''\n        Args:\n            aging_interval_ms: How often
      (in ms) to boost the priority of waiting packets.\n                               Default
      200ms means a packet drops from Priority 5 -> 4 after 0.2s.\n        '', [])'
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [912, 1600.0]
    rotation: 0
    state: enabled
