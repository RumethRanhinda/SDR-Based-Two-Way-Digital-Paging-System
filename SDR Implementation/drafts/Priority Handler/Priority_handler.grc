      \            self.expected_seq[src] = (expected + 1) & 0xFFFF\n            self.send_ack(src,\
      \ self.expected_seq[src])\n            \n            if fin == 1:\n        \
      \        self.push_to_gui(src)\n                \n        elif seq < expected:\n\
      \            # Duplicate packet received, re-send ACK for what we actually need\n\
      \            self.send_ack(src, expected)\n\n    def send_ack(self, target_node,\
      \ next_required_seq):\n        # Header: Dest, Src, Flag=1, Seq, FIN=0, Len=0\n\
      \        header = struct.pack('>BBBHBB', target_node, self.my_addr, 1, next_required_seq,\
      \ 0, 0)\n        \n        # === PRIORITY 0 ===\n        # ACKs must jump the\
      \ queue in the Arbiter\n        meta = pmt.make_dict()\n        meta = pmt.dict_add(meta,\
      \ pmt.intern(\"priority\"), pmt.from_long(0))\n        \n        out_pmt = pmt.cons(meta,\
      \ pmt.init_u8vector(len(header), list(header)))\n        self.message_port_pub(pmt.intern('ack_reply_out'),\
      \ out_pmt)\n\n    def push_to_gui(self, src):\n        try:\n            full_msg_bytes\
      \ = b''.join(self.reassembly_buffer[src])\n            clean_bytes = list(full_msg_bytes)\n\
      \            \n            meta = pmt.make_dict()\n            meta = pmt.dict_add(meta,\
      \ pmt.intern(\"src_id\"), pmt.from_long(src))\n            \n            out_pmt\
      \ = pmt.cons(meta, pmt.init_u8vector(len(clean_bytes), clean_bytes))\n     \
      \       self.message_port_pub(pmt.intern('msg_out'), out_pmt)\n            \n\
      \            self.reassembly_buffer[src] = []\n        except: pass\n"
