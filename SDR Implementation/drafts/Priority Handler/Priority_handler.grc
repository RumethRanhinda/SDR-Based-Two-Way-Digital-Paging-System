      \            max_len: The maximum packet length we expect to scramble.\n   \
      \     \"\"\"\n        gr.basic_block.__init__(\n            self,\n        \
      \    name='PDU Scrambler',\n            in_sig=None,\n            out_sig=None\n\
      \        )\n        self.seed = seed\n        self.max_len = max_len\n     \
      \   \n        # Pre-calculate the scrambling mask during initialization.\n \
